generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"  // relative to prisma/schema.prisma
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL") // or your current postgres URL
}

model User {
  id         Int     @id @default(autoincrement())
  first_name String
  last_name  String
  email      String  @unique
  password   String
  role       String?
}

model RefreshToken {
  id       Int      @id @default(autoincrement())
  hash     String
  expireAt DateTime @default(now())
}

model otp {
  id        Int      @id @default(autoincrement())
  otp       String
  expiresAt DateTime
}
 