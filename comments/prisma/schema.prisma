generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Comments{
  id Int @id @default(autoincrement())
  userId Int
  postId Int
  createdAt DateTime @default(now())
  updatedAt DateTime
}